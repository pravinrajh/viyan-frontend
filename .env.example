# MD EAO Flutter — environment variable documentation
# These are NOT loaded by a dotenv package.
# Pass them via --dart-define when running or building Flutter.
#
# Example (same computer as the Node.js API):
#   flutter run --dart-define=API_BASE_URL=http://localhost:5050
#
# Android emulator:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5050
#
# Physical device (use your machine's LAN IP):
#   flutter run --dart-define=API_BASE_URL=http://192.168.x.x:5050
#
# Screens use live Api*Repository implementations. USE_MOCK_REPOSITORIES is
# leftover config and is not the production switch. Mock classes remain for tests.
#
# Do not put real tokens, passwords, JWT secrets, WhatsApp credentials,
# or database credentials in this repository.

API_BASE_URL=http://localhost:5050
# USE_MOCK_REPOSITORIES is unused by live providers (default true is leftover).

# Production example (when ready):
# API_BASE_URL=https://api.yourdomain.com
